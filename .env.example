# ==== Backend ====
# Leave MONGODB_URI empty to use the automatic JSON-file store
# (server/data/registrations.json). Set a Mongo connection string to use MongoDB.
MONGODB_URI=
# Database name used when connected to MongoDB
MONGODB_DB=reverse_hackathon_2026
# Secret token needed to view the admin dashboard (URL: /#/admin)
ADMIN_TOKEN=change-me
# Port for the API server
PORT=5050